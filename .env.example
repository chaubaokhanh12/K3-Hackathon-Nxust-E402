# Mau cau hinh. Copy sang .env roi dan key that vao (.env da bi gitignore).
#   cp .env.example .env
#
# KHONG dan key that vao file nay: .env.example DUOC git theo doi.

# Key co quyen goi OpenAI Embeddings API + Chat Completions API.
# De trong = bot chay che do tim kiem cuc bo (local-corpus-fallback), khong goi API.
OPENAI_API_KEY= 

# Model embedding. Mac dinh text-embedding-3-small.
# Doi model thi PHAI do lai DIRECT_MATCH_THRESHOLD - xem eval/threshold_calibration.md.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Model sinh van ban cho tang tong hop (payload["generated_answer"]).
# De trong = dung mac dinh gpt-4o-mini. Xem src/agent/synthesis.py.
OPENAI_MODEL=gpt-4o-mini

# Tat tang tong hop LLM: DUPBOT_SYNTHESIS=0
# Chi con suggestions trich nguyen van - dung khi cham diem / do latency.
DUPBOT_SYNTHESIS=1

# ---------------------------------------------------------------------------
# Cau hinh Scope Classification (LLM-based off-topic detection)
# ---------------------------------------------------------------------------

# Mode: "llm" (chi LLM), "keywords" (chi keywords), "hybrid" (LLM primary, keywords fallback)
# Mac dinh "hybrid" de balane accuracy va reliability.
SCOPE_CLASSIFIER=hybrid

# Model cho scope classification (mac dinh: gpt-4o-mini de cost-effective)
SCOPE_CLASSIFIER_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Cau hinh Translation (Multilingual search support)
# ---------------------------------------------------------------------------

# Enable/disable translation (mac dinh: false de cost savings)
TRANSLATION_ENABLED=false

# Service: "openai" (dùng OpenAI API), "null" (không dịch)
# Mac dinh "null" - chi enable khi can thiet.
TRANSLATION_SERVICE=null

# API key cho translation service (khác OpenAI neu dung service khac)
# De trong neu dung OpenAI (se dung OPENAI_API_KEY).
# TRANSLATION_API_KEY=
